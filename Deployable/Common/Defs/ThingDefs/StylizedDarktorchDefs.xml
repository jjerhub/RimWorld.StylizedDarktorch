<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<ThingDef MayRequire="ludeon.rimworld.ideology" Name="DarktorchBase" ParentName="TorchBase" Abstract="True">
	<statBases>
		<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
    </statBases>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
      <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <designationCategory>Furniture</designationCategory>
    <uiOrder>2800</uiOrder>
    <comps Inherit="False">
		<li Class="CompProperties_Styleable" />
		<li Class="CompProperties_Glower">
			<glowRadius>6</glowRadius>
			<glowColor>(78, 226, 229, 0)</glowColor><!-- This is a specific darklight color, make sure it matches DarklightUtility.IsDarklight -->
		</li>
        <li Class="CompProperties_HeatPusher">
            <compClass>CompHeatPusherPowered</compClass>
            <heatPerSecond>3.5</heatPerSecond>
            <heatPushMaxTemperature>23</heatPushMaxTemperature>
        </li>
		<li Class="CompProperties_MeditationFocus">
			<statDef>MeditationFocusStrength</statDef>
			<focusTypes><li>Flame</li></focusTypes>
			<offsets>
				<li Class="FocusStrengthOffset_Lit">
					<offset>0.1</offset>
				</li>
				<li Class="FocusStrengthOffset_BuildingDefsLit">
					<defs>
                        <li>Campfire</li>
                        <li>TorchLamp</li>
                        <li>TorchWallLamp</li>
                        <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
                        <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
                        <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
                        <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
                        <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchWall</li>
                        <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungusWall</li>
					</defs>
					<offsetPerBuilding>0.01</offsetPerBuilding>
					<radius>9.9</radius>
					<maxBuildings>8</maxBuildings>
					<explanationKey>MeditationFocusPerFlame</explanationKey>
					<explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
					<drawRingRadius>false</drawRingRadius>
				</li>
			</offsets>
		</li>
    </comps>
</ThingDef>

<ThingDef MayRequire="ludeon.rimworld.ideology" Name="DarktorchBase_Wall" ParentName="DarktorchBase" Abstract="True">
	<rotatable>true</rotatable>
	<graphicData>
		<graphicClass>Graphic_Multi</graphicClass>
		<drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
		<drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
		<drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
		<drawOffsetEast>(0.9,0,0)</drawOffsetEast>
		<damageData>
			<enabled>false</enabled>
		</damageData>
	</graphicData>
	<altitudeLayer>BuildingOnTop</altitudeLayer>
	<passability>Standable</passability>
	<terrainAffordanceNeeded IsNull="True" />
	<pathCost>0</pathCost>
	<building>
		<isEdifice>false</isEdifice>
		<isAttachment>true</isAttachment>
	</building>
	<statBases>
		<MaxHitPoints>50</MaxHitPoints>
	</statBases>
	<placeWorkers>
		<li>Placeworker_AttachedToWall</li>
	</placeWorkers>
    <comps>
		<li Class="jjerhub.StylizedDarktorch.CompProperties_DarklightOverlay">
			<fireSize>0.4</fireSize>
			<offsetNorth>(0,0,0)</offsetNorth>
			<offsetSouth>(0,0,0.55)</offsetSouth>
			<offsetWest>(0.45,0,0.32)</offsetWest>
			<offsetEast>(-0.45,0,0.32)</offsetEast>
		</li>
	</comps>
</ThingDef>

<ThingDef MayRequire="ludeon.rimworld.ideology" ParentName="DarktorchBase_Wall">
	<defName>DarktorchWall</defName>
	<label>wall darktorch</label>
	<description>A specially-treated, wall-mounted, wooden torch that produces a dim light over a large area. It is not as bright as a regular darktorch lamp, but it can be mounted on walls.  People who prefer darklight work best with this light source. Can be automatically refueled with wood. Produces a small amount of heat.</description>
	<graphicData>
		<texPath>jjerhub.StylizedDarktorch/Darktorch_Wall</texPath>
	</graphicData>
	<uiIconPath>jjerhub.StylizedDarktorch/Darktorch_Wall_MenuIcon</uiIconPath>
	<costList Inherit="False">
		<WoodLog>15</WoodLog>
	</costList>
    <comps>
		<li Class="CompProperties_Refuelable">
			<fuelConsumptionRate>1.5</fuelConsumptionRate>
			<fuelCapacity>20.0</fuelCapacity>
			<fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
			<fuelFilter>
				<thingDefs>
					<li>WoodLog</li>
				</thingDefs>
			</fuelFilter>
			<initialFuelPercent>1</initialFuelPercent>
			<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
		</li>
    </comps>
</ThingDef>

<ThingDef MayRequire="ludeon.rimworld.ideology" ParentName="DarktorchBase_Wall">
	<defName>DarktorchFungusWall</defName>
	<label>wall fungus darktorch</label>
	<description>A specially-treated, wall-mounted, fungus torch that produces a dim light over a large area. It is not as bright as a regular torch lamp, but it can be mounted on walls.  People who prefer darklight work best with this light source. Can be automatically refueled with raw fungus. Produces a small amount of heat.</description>
	<graphicData>
		<texPath>jjerhub.StylizedDarktorch/Darktorch_Fungus_Wall</texPath>
	</graphicData>
	<uiIconPath>jjerhub.StylizedDarktorch/Darktorch_Fungus_Wall_MenuIcon</uiIconPath>
	<uiOrder>2810</uiOrder>
	<costList Inherit="False">
		<RawFungus>15</RawFungus>
	</costList>
	<comps>
		<li Class="CompProperties_Refuelable">
			<fuelConsumptionRate>1.5</fuelConsumptionRate>
			<fuelCapacity>20.0</fuelCapacity>
			<fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
			<fuelFilter>
				<thingDefs>
					<li>RawFungus</li>
				</thingDefs>
			</fuelFilter>
			<initialFuelPercent>1</initialFuelPercent>
			<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
		</li>
	</comps>
</ThingDef>
</Defs>